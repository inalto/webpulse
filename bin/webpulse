#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * WebPulse command line entry point.
 *
 * The installer rewrites the shebang to the cPanel PHP; additionally, when
 * config.json sets "php_bin" and it differs from the running interpreter,
 * the command re-executes itself with that binary.
 */

if (PHP_VERSION_ID < 80100) {
    fwrite(STDERR, "webpulse: PHP >= 8.1 is required (running " . PHP_VERSION . ")\n");
    exit(1);
}

(static function (): void {
    if (getenv('WEBPULSE_REEXEC') === '1') {
        return;
    }
    $cfg = null;
    $argv = $_SERVER['argv'] ?? [];
    foreach ($argv as $i => $a) {
        if ($a === '--config' && isset($argv[$i + 1])) {
            $cfg = $argv[$i + 1];
        } elseif (str_starts_with($a, '--config=')) {
            $cfg = substr($a, 9);
        }
    }
    $cfg ??= getenv('WEBPULSE_CONFIG') ?: '/etc/webpulse/config.json';
    if (!is_readable($cfg)) {
        return;
    }
    $data = json_decode((string) @file_get_contents($cfg), true);
    $bin = is_array($data) ? ($data['php_bin'] ?? null) : null;
    if (!is_string($bin) || $bin === '' || !is_executable($bin)) {
        return;
    }
    if (realpath($bin) === realpath(PHP_BINARY)) {
        return;
    }
    putenv('WEBPULSE_REEXEC=1');
    $proc = proc_open(array_merge([$bin, __FILE__], array_slice($argv, 1)), [0 => STDIN, 1 => STDOUT, 2 => STDERR], $pipes);
    exit(is_resource($proc) ? proc_close($proc) : 1);
})();

if (!extension_loaded('pdo_sqlite')) {
    fwrite(STDERR, "webpulse: the pdo_sqlite extension is required\n");
    exit(1);
}

// the log parser is regex heavy: PCRE JIT roughly doubles its speed
@ini_set('pcre.jit', '1');
$limit = (string) ini_get('memory_limit');
if ($limit !== '-1' && (int) $limit > 0 && (int) $limit * (str_ends_with(strtoupper($limit), 'G') ? 1024 : (str_ends_with(strtoupper($limit), 'M') ? 1 : 1 / 1048576)) < 512) {
    @ini_set('memory_limit', '512M');
}

require dirname(__DIR__) . '/lib/autoload.php';

exit(WebPulse\Cli\Cli::main($_SERVER['argv'] ?? []));
